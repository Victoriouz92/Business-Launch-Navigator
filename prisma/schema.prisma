generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  emailVerified      DateTime?
  verificationToken  String?
  verificationExpiry DateTime?
  resetToken         String?
  resetExpiry        DateTime?
  hasPaid            Boolean   @default(false)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  projects     Project[]
  bookmarks    Bookmark[]
  achievements UserAchievement[]

  @@index([email])
}

model Project {
  id                String   @id @default(cuid())
  userId            String
  name              String
  businessType      String
  onlineOfflineType String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  stepProgress StepProgress[]

  @@index([userId])
}

model StepProgress {
  id          String    @id @default(cuid())
  projectId   String
  stepId      String
  completed   Boolean   @default(false)
  completedAt DateTime?
  note        String?
  updatedAt   DateTime  @updatedAt

  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subTaskProgress SubTaskProgress[]

  @@unique([projectId, stepId])
  @@index([projectId])
}

model SubTaskProgress {
  id             String   @id @default(cuid())
  stepProgressId String
  subTaskIndex   Int
  completed      Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  stepProgress StepProgress @relation(fields: [stepProgressId], references: [id], onDelete: Cascade)

  @@unique([stepProgressId, subTaskIndex])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  stepId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, stepId])
  @@index([userId])
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}
